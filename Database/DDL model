-- Schema
CREATE SCHEMA IF NOT EXISTS public;

-- Timestamp update trigger
CREATE OR REPLACE FUNCTION set_updated_at()
RETURNS trigger AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

---------------------------------------------------------------------
-- TABLE: customer
---------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS public.customer (
    customer_id      BIGSERIAL PRIMARY KEY,
    customer_name    text NOT NULL,
    last_name        text NOT NULL,
    first_name       text NOT NULL,
    street_number    text NOT NULL,
    postal_code      text NOT NULL,
    city             text NOT NULL,
    phone            varchar(20),
    cellphone        varchar(20), 
    created_at       timestamptz NOT NULL DEFAULT now(),
    updated_at       timestamptz NOT NULL DEFAULT now()
);

---------------------------------------------------------------------
-- TABLE: users
---------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS public.users (
    user_id       SERIAL PRIMARY KEY,
    email         text NOT NULL UNIQUE,
    password_hash text,
    name          text NOT NULL,
    role          varchar(50) NOT NULL,
    is_active     boolean NOT NULL DEFAULT true,
    street_number text NOT NULL,
    postal_code   text NOT NULL,
    city          text NOT NULL,
    created_at    timestamptz NOT NULL DEFAULT now(),
    updated_at    timestamptz NOT NULL DEFAULT now()
);

---------------------------------------------------------------------
-- TABLE: vehicle
---------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS public.vehicle (
    vehicle_id    BIGSERIAL PRIMARY KEY,
    license_plate varchar(20) NOT NULL UNIQUE,
    brand         text NOT NULL,
    model         text,
    color         text,
    capacity_kg   numeric(10,0),
    fuel_type     text NOT NULL,
    is_active     boolean NOT NULL DEFAULT true,
    created_at    timestamptz NOT NULL DEFAULT now(),
    updated_at    timestamptz NOT NULL DEFAULT now()
);

---------------------------------------------------------------------
-- TABLE: product
---------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS public.product (
    product_id   BIGSERIAL PRIMARY KEY,
    weight_kg    numeric(10,0),
    product_name varchar(255) NOT NULL,
    created_at   timestamptz NOT NULL DEFAULT now(),
    updated_at   timestamptz NOT NULL DEFAULT now()
);

---------------------------------------------------------------------
-- TABLE: purchase_orders
---------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS public.purchase_orders (
    order_id              BIGSERIAL PRIMARY KEY,
    payment_status        text NOT NULL,
    delivery_address      text NOT NULL,
    customer_id           integer NOT NULL,
    delivery_phone        varchar(20) NOT NULL,
    delivery_window_start timestamptz NOT NULL,
    delivery_window_end   timestamptz NOT NULL,
    total_weight_kg       numeric(10,0) NOT NULL,
    order_status          text NOT NULL,
    lat                   numeric(10,6),
    ing                   numeric(10,6),
    created_at            timestamptz NOT NULL DEFAULT now(),
    updated_at            timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT fk_purchase_orders_customer
        FOREIGN KEY (customer_id)
        REFERENCES public.customer(customer_id)
);

---------------------------------------------------------------------
-- TABLE: route
---------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS public.route (
    route_id           BIGSERIAL PRIMARY KEY,
    driver_id          integer NOT NULL,
    vehicle_id         integer NOT NULL,
    created_by_user_id integer NOT NULL,
    route_date         date NOT NULL,
    route_status       text NOT NULL,
    started_at         timestamptz,
    completed_at       timestamptz,
    driver_day_comment text,
    created_at         timestamptz NOT NULL DEFAULT now(),
    updated_at         timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT fk_route_driver     FOREIGN KEY (driver_id)          REFERENCES public.users(user_id),
    CONSTRAINT fk_route_creator    FOREIGN KEY (created_by_user_id) REFERENCES public.users(user_id),
    CONSTRAINT fk_route_vehicle    FOREIGN KEY (vehicle_id)         REFERENCES public.vehicle(vehicle_id)
);

---------------------------------------------------------------------
-- TABLE: order_item
---------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS public.order_item (
    order_item_id BIGSERIAL PRIMARY KEY,
    order_id      integer NOT NULL,
    product_id    integer NOT NULL,
    quantity      integer NOT NULL,
    created_at    timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT fk_order_item_order
        FOREIGN KEY (order_id) REFERENCES public.purchase_orders(order_id)
        ON DELETE CASCADE,
    CONSTRAINT fk_order_item_product
        FOREIGN KEY (product_id) REFERENCES public.product(product_id)
);

---------------------------------------------------------------------
-- TABLE: route_delivery
---------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS public.route_delivery (
    route_delivery_id BIGSERIAL PRIMARY KEY,
    route_id          integer NOT NULL,
    order_id          integer NOT NULL,
    sequence          integer NOT NULL,
    delivery_status   text,
    delivery_at       timestamptz,
    delivery_comment  text,
    created_at        timestamptz NOT NULL DEFAULT now(),
    updated_at        timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT fk_route_delivery_route
        FOREIGN KEY (route_id) REFERENCES public.route(route_id),
    CONSTRAINT fk_route_delivery_order
        FOREIGN KEY (order_id) REFERENCES public.purchase_orders(order_id)
);

---------------------------------------------------------------------
-- Triggers: updated_at automatisch bijwerken
---------------------------------------------------------------------

CREATE TRIGGER trg_customer_updated
BEFORE UPDATE ON public.customer
FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TRIGGER trg_users_updated
BEFORE UPDATE ON public.users
FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TRIGGER trg_vehicle_updated
BEFORE UPDATE ON public.vehicle
FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TRIGGER trg_product_updated
BEFORE UPDATE ON public.product
FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TRIGGER trg_purchase_orders_updated
BEFORE UPDATE ON public.purchase_orders
FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TRIGGER trg_route_updated
BEFORE UPDATE ON public.route
FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TRIGGER trg_route_delivery_updated
BEFORE UPDATE ON public.route_delivery
FOR EACH ROW EXECUTE FUNCTION set_updated_at();
