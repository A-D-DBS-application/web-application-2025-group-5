-- Drop all tables in reverse order of dependencies
DROP TABLE IF EXISTS "public"."route_delivery" CASCADE;
DROP TABLE IF EXISTS "public"."Route" CASCADE;
DROP TABLE IF EXISTS "public"."Purchase_orders" CASCADE;
DROP TABLE IF EXISTS "public"."order_item" CASCADE;
DROP TABLE IF EXISTS "public"."product" CASCADE;
DROP TABLE IF EXISTS "public"."customer" CASCADE;
DROP TABLE IF EXISTS "public"."user" CASCADE;
DROP TABLE IF EXISTS "public"."vehicle" CASCADE;

-- Now run your CREATE TABLE statements
CREATE SCHEMA IF NOT EXISTS "public";

CREATE TABLE "public"."Purchase_orders" (
    "payment_status" text NOT NULL,
    "order_id" SERIAL PRIMARY KEY,
    "delivery_address" text NOT NULL,
    "customer_id" integer NOT NULL,
    "delivery_phone" varchar(20) NOT NULL,
    "delivery_window_start" timestamp NOT NULL,
    "delivery_window_end" timestamp NOT NULL,
    "total_weight_kg" decimal NOT NULL,
    "order_status" text NOT NULL,
    "created_at" timestamp NOT NULL,
    "updated_at" timestamp NOT NULL
);

CREATE TABLE "public"."product" (
    "product_id" SERIAL PRIMARY KEY,
    "available_qty" integer,
    "product_name" varchar(255) NOT NULL,
    "created_at" timestamp NOT NULL,
    "updated_at" timestamp NOT NULL
);

CREATE TABLE "public"."Route" (
    "route_id" SERIAL PRIMARY KEY,
    "driver_id" integer NOT NULL,
    "vehicle_id" integer NOT NULL,
    "created_by_user_id" integer NOT NULL,
    "route_date" date NOT NULL,
    "route_status" text NOT NULL,
    "started_at" timestamp NOT NULL,
    "completed_at" timestamp NOT NULL,
    "driver_day_comment" text NOT NULL,
    "created_at" timestamp NOT NULL,
    "updated_at" timestamp NOT NULL
);

CREATE TABLE "public"."order_item" (
    "order_item_id" SERIAL PRIMARY KEY,
    "order_id" integer NOT NULL,
    "product_id" integer NOT NULL,
    "quantity" integer,
    "price_per_unit" decimal,
    "created_at" timestamp NOT NULL
);

CREATE TABLE "public"."customer" (
    "customer_id" SERIAL PRIMARY KEY,
    "name" text NOT NULL,
    "adress" text NOT NULL,
    "phone" varchar(20) NOT NULL,
    "created_at" timestamp NOT NULL,
    "updated_at" timestamp NOT NULL
);

CREATE TABLE "public"."user" (
    "user_id" SERIAL PRIMARY KEY,
    "email" text NOT NULL,
    "password_hash" text NOT NULL,
    "name" text NOT NULL,
    "role" varchar(50) NOT NULL,
    "is_active" boolean NOT NULL DEFAULT true,
    "created_at" timestamp NOT NULL,
    "updated_at" timestamp NOT NULL
);

CREATE TABLE "public"."vehicle" (
    "vehicle_id" SERIAL PRIMARY KEY,
    "license_plate" varchar(20) NOT NULL,
    "brand" text NOT NULL,
    "model" text,
    "capacity_kg" decimal,
    "is_active" boolean NOT NULL DEFAULT true,
    "created_at" timestamp NOT NULL,
    "updated_at" timestamp NOT NULL
);

CREATE TABLE "public"."route_delivery" (
    "route_delivery_id" SERIAL PRIMARY KEY,
    "route_id" integer NOT NULL,
    "order_id" integer NOT NULL,
    "stop_sequence" integer NOT NULL,
    "delivery_status" text,
    "delivery_at" timestamp,
    "delivery_comment" text,
    "created_at" timestamp NOT NULL,
    "updated_at" timestamp NOT NULL
);

-- Foreign key constraints
ALTER TABLE "public"."order_item"
    ADD CONSTRAINT "fk_order_item_product_id_product_product_id"
    FOREIGN KEY("product_id") REFERENCES "public"."product"("product_id");

ALTER TABLE "public"."order_item"
    ADD CONSTRAINT "fk_order_item_order_id_Purchase_orders_order_id"
    FOREIGN KEY("order_id") REFERENCES "public"."Purchase_orders"("order_id");

ALTER TABLE "public"."Purchase_orders"
    ADD CONSTRAINT "fk_Purchase_orders_customer_id_customer_customer_id"
    FOREIGN KEY("customer_id") REFERENCES "public"."customer"("customer_id");

ALTER TABLE "public"."route_delivery"
    ADD CONSTRAINT "fk_route_delivery_order_id_Purchase_orders_order_id"
    FOREIGN KEY("order_id") REFERENCES "public"."Purchase_orders"("order_id");

ALTER TABLE "public"."route_delivery"
    ADD CONSTRAINT "fk_route_delivery_route_id_Route_route_id"
    FOREIGN KEY("route_id") REFERENCES "public"."Route"("route_id");

ALTER TABLE "public"."Route"
    ADD CONSTRAINT "fk_Route_created_by_user_id_user_user_id"
    FOREIGN KEY("created_by_user_id") REFERENCES "public"."user"("user_id");

ALTER TABLE "public"."Route"
    ADD CONSTRAINT "fk_Route_driver_id_user_user_id"
    FOREIGN KEY("driver_id") REFERENCES "public"."user"("user_id");

ALTER TABLE "public"."Route"
    ADD CONSTRAINT "fk_Route_vehicle_id_vehicle_vehicle_id"
    FOREIGN KEY("vehicle_id") REFERENCES "public"."vehicle"("vehicle_id");

